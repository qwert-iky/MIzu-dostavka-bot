# =====================================================================
# Шаблон переменных окружения для деплоя на Render.com / VPS
# =====================================================================

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Список ID администраторов через запятую (ОБЯЗАТЕЛЬНО)
ADMIN_IDS=1661553201

# Публичный URL вашего Web Service на Render (ОБЯЗАТЕЛЬНО для Mini App!)
# Пример: https://suv-bot-routing.onrender.com
WEBAPP_URL=https://your-service-name.onrender.com

# Дефолтная Точка А (старт маршрутов)
DEFAULT_ORIGIN_LAT=41.2858
DEFAULT_ORIGIN_LON=69.2036
DEFAULT_ORIGIN_NAME=Фархадский базар (Farhod bozori)

# Параметры сервера (Render сам автоматически задаёт PORT через переменную PORT)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# База данных SQLite
DB_PATH=data/bot.db

# User-Agent для геокодирования через OpenStreetMap Nominatim
GEOCODER_USER_AGENT=SuvBotRoutePlanner/1.0
